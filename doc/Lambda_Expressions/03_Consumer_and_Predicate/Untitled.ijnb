      "source": "// Folder resource\\Section 14\\4 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Consumer-&-Predicate\\LambdaExpressions\\src\n// 2 printable files\n// (file list disabled)\n\n// resource\\Section 14\\4 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Consumer-&-Predicate\\LambdaExpressions\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.List;\n6\timport java.util.function.BiConsumer;\n7\timport java.util.function.BinaryOperator;\n8\t\n9\tpublic class Main {\n10\t\n11\t    public static void main(String[] args) {\n12\t\n13\t        List<String> list = new ArrayList<>(List.of(\n14\t                \"alpha\", \"bravo\", \"charlie\", \"delta\"));\n15\t\n16\t        for (String s : list) {\n17\t            System.out.println(s);\n18\t        }\n19\t\n20\t        System.out.println(\"-------\");\n21\t        list.forEach((var myString) -> System.out.println(myString));\n22\t\n23\t        System.out.println(\"-------\");\n24\t        String prefix = \"nato\";\n25\t        list.forEach((var myString) -> {\n26\t            char first = myString.charAt(0);\n27\t            System.out.println(prefix + \" \" + myString + \" means \" + first);\n28\t        });\n29\t\n30\t        int result = calculator((var a, var b) -> a + b,5, 2);\n31\t        var result2 = calculator((a, b) -> a / b, 10.0, 2.5);\n32\t        var result3 = calculator(\n33\t                (a, b) -> a.toUpperCase() + \" \" + b.toUpperCase(),\n34\t                \"Ralph\", \"Kramden\");\n35\t\n36\t        var coords = Arrays.asList(\n37\t                new double[]{47.2160, -95.2348},\n38\t                new double[]{29.1566, -89.2495},\n39\t                new double[]{35.1556, -90.0659});\n40\t\n41\t        coords.forEach(s -> System.out.println(Arrays.toString(s)));\n42\t\n43\t        BiConsumer<Double,Double> p1 = (lat, lng) ->\n44\t                System.out.printf(\"[lat:%.3f lon:%.3f]%n\", lat, lng);\n45\t\n46\t        var firstPoint = coords.get(0);\n47\t        processPoint(firstPoint[0], firstPoint[1], p1);\n48\t\n49\t        System.out.println(\"-------\");\n50\t        coords.forEach(s -> processPoint(s[0], s[1], p1));\n51\t        coords.forEach(s -> processPoint(s[0], s[1],\n52\t                (lat, lng) ->\n53\t                        System.out.printf(\"[lat:%.3f lon:%.3f]%n\", lat, lng)));\n54\t\n55\t        list.removeIf(s -> s.equalsIgnoreCase(\"bravo\"));\n56\t        list.forEach(s -> System.out.println(s));\n57\t\n58\t        list.addAll(List.of(\"echo\", \"easy\", \"earnest\"));\n59\t        list.forEach(s -> System.out.println(s));\n60\t\n61\t        System.out.println(\"-------\");\n62\t        list.removeIf(s -> s.startsWith(\"ea\"));\n63\t        list.forEach(s -> System.out.println(s));\n64\t\n65\t    }\n66\t\n67\t    public static <T> T calculator(BinaryOperator<T> function, T value1, T value2) {\n68\t\n69\t        T result = function.apply(value1, value2);\n70\t        System.out.println(\"Result of operation: \" + result);\n71\t        return result;\n72\t    }\n73\t\n74\t    public static <T> void processPoint(T t1, T t2, BiConsumer<T,T> consumer) {\n75\t        consumer.accept(t1, t2);\n76\t    }\n77\t}\n78\t \n// resource\\Section 14\\4 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Consumer-&-Predicate\\LambdaExpressions\\src\\dev\\lpa\\Operation.java\n1\tpackage dev.lpa;\n2\t\n3\t@FunctionalInterface\n4\tpublic interface Operation<T> {\n5\t\n6\t    T operate(T value1, T value2);\n7\t}\n8\t ",
