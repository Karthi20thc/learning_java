      "id": "69b62677-599d-4a7e-ad68-4dc5f31af87a",
      "cell_type": "code",
      "source": "// Folder resource\\Section 14\\1 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Introduction-to-the-Lambda-Expression-and-Functional-Interfaces\\LambdaIntro\\src\n// 1 printable files\n// (file list disabled)\n\n// resource\\Section 14\\1 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Introduction-to-the-Lambda-Expression-and-Functional-Interfaces\\LambdaIntro\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.Comparator;\n6\timport java.util.List;\n7\t\n8\tpublic class Main {\n9\t\n10\t    record Person (String firstName, String lastName) {\n11\t\n12\t        @Override\n13\t        public String toString() {\n14\t            return firstName + \" \" + lastName;\n15\t        }\n16\t    }\n17\t\n18\t    public static void main(String[] args) {\n19\t\n20\t        List<Person> people = new ArrayList<>(Arrays.asList(\n21\t                new Main.Person(\"Lucy\", \"Van Pelt\"),\n22\t                new Person(\"Sally\", \"Brown\"),\n23\t                new Person(\"Linus\", \"Van Pelt\"),\n24\t                new Person(\"Peppermint\", \"Patty\"),\n25\t                new Person(\"Charlie\", \"Brown\")));\n26\t\n27\t        // Using anonymous class\n28\t        var comparatorLastName = new Comparator<Person>() {\n29\t\n30\t            @Override\n31\t            public int compare(Person o1, Person o2) {\n32\t                return o1.lastName().compareTo(o2.lastName());\n33\t            }\n34\t        };\n35\t\n36\t        people.sort((o1, o2) -> o1.lastName().compareTo(o2.lastName()));\n37\t        System.out.println(people);\n38\t\n39\t        interface EnhancedComparator<T> extends Comparator<T> {\n40\t            int secondLevel(T o1, T o2);\n41\t        }\n42\t\n43\t        var comparatorMixed = new EnhancedComparator<Person>() {\n44\t\n45\t            @Override\n46\t            public int compare(Person o1, Person o2) {\n47\t                int result = o1.lastName().compareTo(o2.lastName());\n48\t                return (result == 0 ? secondLevel(o1, o2) : result);\n49\t            }\n50\t\n51\t            @Override\n52\t            public int secondLevel(Person o1, Person o2) {\n53\t                return o1.firstName().compareTo(o2.firstName());\n54\t            }\n55\t        };\n56\t\n57\t        people.sort(comparatorMixed);\n58\t        System.out.println(people);\n59\t\n60\t    }\n61\t}\n62\t ",
