      "source": "Folder resource\\Section 14\\9 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-The-Most-Confusing-of-the-Method-References\\MethodReferences\\src\n1 printable files\n(file list disabled)\n\nresource\\Section 14\\9 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-The-Most-Confusing-of-the-Method-References\\MethodReferences\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.List;\n6\timport java.util.function.*;\n7\t\n8\tclass PlainOld {\n9\t\n10\t    private static int last_id = 1;\n11\t\n12\t    private int id;\n13\t\n14\t    public PlainOld() {\n15\t        id = PlainOld.last_id++;\n16\t        System.out.println(\"Creating a PlainOld Object: id = \" + id);\n17\t    }\n18\t}\n19\t\n20\tpublic class Main {\n21\t\n22\t    public static void main(String[] args) {\n23\t\n24\t        List<String> list = new ArrayList<>(List.of(\n25\t                \"Anna\", \"Bob\", \"Chuck\", \"Dave\"));\n26\t\n27\t        list.forEach(System.out::println);\n28\t\n29\t        calculator(Integer::sum, 10, 25);\n30\t        calculator(Double::sum, 2.5, 7.5);\n31\t\n32\t        Supplier<PlainOld> reference1 = PlainOld::new;\n33\t\n34\t        PlainOld newPojo = reference1.get();\n35\t\n36\t        System.out.println(\"Getting array\");\n37\t        PlainOld[] pojo1 = seedArray(PlainOld::new, 10);\n38\t\n39\t        calculator((s1, s2) -> s1.concat(s2), \"Hello \", \"World\");\n40\t        calculator(String::concat, \"Hello \", \"World\");\n41\t\n42\t        BinaryOperator<String> b1 = String::concat;\n43\t        BiFunction<String, String, String> b2 = String::concat;\n44\t        UnaryOperator<String> u1 = String::toUpperCase;\n45\t\n46\t        System.out.println(b1.apply(\"Hello \",\"World\"));\n47\t        System.out.println(b2.apply(\"Hello \",\"World\"));\n48\t        System.out.println(u1.apply(\"Hello \"));\n49\t\n50\t        String result = \"Hello\".transform(u1);\n51\t        System.out.println(\"Result = \" + result);\n52\t\n53\t        result = result.transform(String::toLowerCase);\n54\t        System.out.println(\"Result = \" + result);\n55\t\n56\t        Function<String, Boolean> f0 = String::isEmpty;\n57\t        boolean resultBoolean = result.transform(f0);\n58\t        System.out.println(\"Result = \" + resultBoolean);\n59\t\n60\t    }\n61\t\n62\t    private static <T> void calculator(BinaryOperator<T> function, T value1, T value2) {\n63\t\n64\t        T result = function.apply(value1, value2);\n65\t        System.out.println(\"Result of operation: \" + result);\n66\t    }\n67\t\n68\t    private static PlainOld[] seedArray(Supplier<PlainOld> reference, int count) {\n69\t\n70\t        PlainOld[] array = new PlainOld[count];\n71\t        Arrays.setAll(array, i -> reference.get());\n72\t        return array;\n73\t    }\n74\t\n75\t}\n76\t ",
