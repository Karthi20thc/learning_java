      "cell_type": "code",
      "source": "// Folder resource\\Section 14\\8 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-What's-a-Method-Reference\\MethodReferences\\src\n// 1 printable files\n// (file list disabled)\n\n// resource\\Section 14\\8 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-What's-a-Method-Reference\\MethodReferences\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.List;\n6\timport java.util.function.BinaryOperator;\n7\timport java.util.function.Supplier;\n8\t\n9\tclass PlainOld {\n10\t\n11\t    private static int last_id = 1;\n12\t\n13\t    private int id;\n14\t\n15\t    public PlainOld() {\n16\t        id = PlainOld.last_id++;\n17\t        System.out.println(\"Creating a PlainOld Object: id = \" + id);\n18\t    }\n19\t}\n20\t\n21\tpublic class Main {\n22\t\n23\t    public static void main(String[] args) {\n24\t\n25\t        List<String> list = new ArrayList<>(List.of(\n26\t                \"Anna\", \"Bob\", \"Chuck\", \"Dave\"));\n27\t\n28\t        list.forEach(System.out::println);\n29\t\n30\t        calculator(Integer::sum, 10, 25);\n31\t        calculator(Double::sum, 2.5, 7.5);\n32\t\n33\t        Supplier<PlainOld> reference1 = PlainOld::new;\n34\t\n35\t        PlainOld newPojo = reference1.get();\n36\t\n37\t        System.out.println(\"Getting array\");\n38\t        PlainOld[] pojo1 = seedArray(PlainOld::new, 10);\n39\t\n40\t    }\n41\t\n42\t    private static <T> void calculator(BinaryOperator<T> function, T value1, T value2) {\n43\t\n44\t        T result = function.apply(value1, value2);\n45\t        System.out.println(\"Result of operation: \" + result);\n46\t    }\n47\t\n48\t    private static PlainOld[] seedArray(Supplier<PlainOld> reference, int count) {\n49\t\n50\t        PlainOld[] array = new PlainOld[count];\n51\t        Arrays.setAll(array, i -> reference.get());\n52\t        return array;\n53\t    }\n54\t\n55\t}\n56\t ",
