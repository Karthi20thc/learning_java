      "source": "// Folder resource\\Section 14\\3 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Lambda-Expressions-Continued\\LambdaExpressions\\src\n// 2 printable files\n// (file list disabled)\n\n// resource\\Section 14\\3 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Lambda-Expressions-Continued\\LambdaExpressions\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.List;\n5\t\n6\tpublic class Main {\n7\t\n8\t    public static void main(String[] args) {\n9\t\n10\t        List<String> list = new ArrayList<>(List.of(\n11\t                \"alpha\", \"bravo\", \"charlie\", \"delta\"));\n12\t\n13\t        for (String s : list) {\n14\t            System.out.println(s);\n15\t        }\n16\t\n17\t        System.out.println(\"-------\");\n18\t        list.forEach((var myString) -> System.out.println(myString));\n19\t\n20\t        System.out.println(\"-------\");\n21\t        String prefix = \"nato\";\n22\t        list.forEach((var myString) -> {\n23\t            char first = myString.charAt(0);\n24\t            System.out.println(prefix + \" \" + myString + \" means \" + first);\n25\t        });\n26\t\n27\t        int result = calculator((var a, var b) -> a + b,5, 2);\n28\t        var result2 = calculator((a, b) -> a / b, 10.0, 2.5);\n29\t        var result3 = calculator(\n30\t                (a, b) -> a.toUpperCase() + \" \" + b.toUpperCase(),\n31\t                \"Ralph\", \"Kramden\");\n32\t\n33\t    }\n34\t\n35\t    public static <T> T calculator(Operation<T> function, T value1, T value2) {\n36\t\n37\t        T result = function.operate(value1, value2);\n38\t        System.out.println(\"Result of operation: \" + result);\n39\t        return result;\n40\t    }\n41\t\n42\t}\n43\t \n// resource\\Section 14\\3 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Lambda-Expressions-Continued\\LambdaExpressions\\src\\dev\\lpa\\Operation.java\n1\tpackage dev.lpa;\n2\t\n3\t@FunctionalInterface\n4\tpublic interface Operation<T> {\n5\t\n6\t    T operate(T value1, T value2);\n7\t}\n8\t ",
