      "source": "// Folder resource\\Section 14\\5 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Function-&-Supplier\\LambdaExpressions\\src\n// 2 printable files\n// (file list disabled)\n\n// resource\\Section 14\\5 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Function-&-Supplier\\LambdaExpressions\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.Arrays;\n5\timport java.util.List;\n6\timport java.util.Random;\n7\timport java.util.function.BiConsumer;\n8\timport java.util.function.BinaryOperator;\n9\timport java.util.function.Supplier;\n10\t\n11\tpublic class Main {\n12\t\n13\t    public static void main(String[] args) {\n14\t\n15\t        List<String> list = new ArrayList<>(List.of(\n16\t                \"alpha\", \"bravo\", \"charlie\", \"delta\"));\n17\t\n18\t        for (String s : list) {\n19\t            System.out.println(s);\n20\t        }\n21\t\n22\t        System.out.println(\"-------\");\n23\t        list.forEach((var myString) -> System.out.println(myString));\n24\t\n25\t        System.out.println(\"-------\");\n26\t        String prefix = \"nato\";\n27\t        list.forEach((var myString) -> {\n28\t            char first = myString.charAt(0);\n29\t            System.out.println(prefix + \" \" + myString + \" means \" + first);\n30\t        });\n31\t\n32\t        int result = calculator((var a, var b) -> a + b,5, 2);\n33\t        var result2 = calculator((a, b) -> a / b, 10.0, 2.5);\n34\t        var result3 = calculator(\n35\t                (a, b) -> a.toUpperCase() + \" \" + b.toUpperCase(),\n36\t                \"Ralph\", \"Kramden\");\n37\t\n38\t        var coords = Arrays.asList(\n39\t                new double[]{47.2160, -95.2348},\n40\t                new double[]{29.1566, -89.2495},\n41\t                new double[]{35.1556, -90.0659});\n42\t\n43\t        coords.forEach(s -> System.out.println(Arrays.toString(s)));\n44\t\n45\t        BiConsumer<Double,Double> p1 = (lat, lng) ->\n46\t                System.out.printf(\"[lat:%.3f lon:%.3f]%n\", lat, lng);\n47\t\n48\t        var firstPoint = coords.get(0);\n49\t        processPoint(firstPoint[0], firstPoint[1], p1);\n50\t\n51\t        System.out.println(\"-------\");\n52\t        coords.forEach(s -> processPoint(s[0], s[1], p1));\n53\t        coords.forEach(s -> processPoint(s[0], s[1],\n54\t                (lat, lng) ->\n55\t                        System.out.printf(\"[lat:%.3f lon:%.3f]%n\", lat, lng)));\n56\t\n57\t        list.removeIf(s -> s.equalsIgnoreCase(\"bravo\"));\n58\t        list.forEach(s -> System.out.println(s));\n59\t\n60\t        list.addAll(List.of(\"echo\", \"easy\", \"earnest\"));\n61\t        list.forEach(s -> System.out.println(s));\n62\t\n63\t        System.out.println(\"-------\");\n64\t        list.removeIf(s -> s.startsWith(\"ea\"));\n65\t        list.forEach(s -> System.out.println(s));\n66\t\n67\t        list.replaceAll(s -> s.charAt(0) + \" - \" + s.toUpperCase());\n68\t        System.out.println(\"-------\");\n69\t        list.forEach(s -> System.out.println(s));\n70\t\n71\t        String[] emptyStrings = new String[10];\n72\t        System.out.println(Arrays.toString(emptyStrings));\n73\t        Arrays.fill(emptyStrings,\"\");\n74\t        System.out.println(Arrays.toString(emptyStrings));\n75\t\n76\t        Arrays.setAll(emptyStrings, (i) -> \"\" + (i + 1) + \". \");\n77\t        System.out.println(Arrays.toString(emptyStrings));\n78\t\n79\t        Arrays.setAll(emptyStrings, (i) -> \"\" + (i + 1) + \". \"\n80\t            + switch (i) {\n81\t                    case 0 -> \"one\";\n82\t                    case 1 -> \"two\";\n83\t                    case 2 -> \"three\";\n84\t                    default -> \"\";\n85\t                }\n86\t        );\n87\t        System.out.println(Arrays.toString(emptyStrings));\n88\t\n89\t        String[] names = {\"Ann\", \"Bob\", \"Carol\", \"David\", \"Ed\", \"Fred\"};\n90\t        String[] randomList = randomlySelectedValu­es(15, names,\n91\t                () -> new Random().nextInt(0, names.length));\n92\t        System.out.println(Arrays.toString(randomList));\n93\t\n94\t    }\n95\t\n96\t    public static <T> T calculator(BinaryOperator<T> function, T value1, T value2) {\n97\t\n98\t        T result = function.apply(value1, value2);\n99\t        System.out.println(\"Result of operation: \" + result);\n100\t        return result;\n101\t    }\n102\t\n103\t    public static <T> void processPoint(T t1, T t2, BiConsumer<T,T> consumer) {\n104\t        consumer.accept(t1, t2);\n105\t    }\n106\t\n107\t    public static String[] randomlySelectedValu­es(int count,\n108\t                                                  String[] values,\n109\t                                                  Supplier<Integer> s) {\n110\t\n111\t        String[] selectedValues = new String[count];\n112\t        for (int i = 0; i < count; i++) {\n113\t            selectedValues[i] = values[s.get()];\n114\t        }\n115\t        return selectedValues;\n116\t    }\n117\t}\n118\t \n// resource\\Section 14\\5 Source-code-Lambda-Expressions-Functional-Interfaces-and-Method-References-Java's-Functional-Interfaces-Function-&-Supplier\\LambdaExpressions\\src\\dev\\lpa\\Operation.java\n1\tpackage dev.lpa;\n2\t\n3\t@FunctionalInterface\n4\tpublic interface Operation<T> {\n5\t\n6\t    T operate(T value1, T value2);\n7\t}\n8\t ",
