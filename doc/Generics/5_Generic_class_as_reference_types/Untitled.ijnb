      "cell_type": "code",
      "source": "// Folder resource\\Section 12\\7 Source-code-Generics-Generic-classes-as-reference-types\\GenericsExtra\\src\n// 3 printable files\n// (file list disabled)\n\n// resource\\Section 12\\7 Source-code-Generics-Generic-classes-as-reference-types\\GenericsExtra\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.model.LPAStudent;\n4\timport dev.lpa.model.Student;\n5\t\n6\timport java.util.ArrayList;\n7\timport java.util.List;\n8\t\n9\tpublic class Main {\n10\t\n11\t    public static void main(String[] args) {\n12\t\n13\t        int studentCount = 10;\n14\t        List<Student> students = new ArrayList<>();\n15\t        for (int i = 0; i < studentCount; i++) {\n16\t            students.add(new Student());\n17\t        }\n18\t        students.add(new LPAStudent());\n19\t        printList(students);\n20\t\n21\t        List<LPAStudent> lpaStudents = new ArrayList<>();\n22\t        for (int i = 0; i < studentCount; i++) {\n23\t            lpaStudents.add(new LPAStudent());\n24\t        }\n25\t        printList(lpaStudents);\n26\t    }\n27\t\n28\t    public static void printList(List students) {\n29\t\n30\t        for (var student : students) {\n31\t            System.out.println(student);\n32\t        }\n33\t        System.out.println();\n34\t    }\n35\t}\n// resource\\Section 12\\7 Source-code-Generics-Generic-classes-as-reference-types\\GenericsExtra\\src\\dev\\lpa\\model\\LPAStudent.java\n1\tpackage dev.lpa.model;\n2\t\n3\tpublic class LPAStudent extends Student {\n4\t\n5\t    private double percentComplete;\n6\t\n7\t    public LPAStudent() {\n8\t        percentComplete = random.nextDouble(0, 100.001);\n9\t    }\n10\t\n11\t    @Override\n12\t    public String toString() {\n13\t        return \"%s %8.1f%%\".formatted(super.toString(), percentComplete);\n14\t    }\n15\t\n16\t    public double getPercentComplete() {\n17\t        return percentComplete;\n18\t    }\n19\t}\n20\t \n// resource\\Section 12\\7 Source-code-Generics-Generic-classes-as-reference-types\\GenericsExtra\\src\\dev\\lpa\\model\\Student.java\n1\tpackage dev.lpa.model;\n2\t\n3\timport java.util.Random;\n4\t\n5\tpublic class Student {\n6\t\n7\t    private String name;\n8\t    private String course;\n9\t    private int yearStarted;\n10\t\n11\t    protected static Random random = new Random();\n12\t\n13\t    private static String[] firstNames = {\"Ann\", \"Bill\", \"Cathy\", \"John\", \"Tim\"};\n14\t    private static String[] courses = {\"C++\", \"Java\", \"Python\"};\n15\t\n16\t    public Student() {\n17\t        int lastNameIndex = random.nextInt(65, 91);\n18\t        name = firstNames[random.nextInt(5)] + \" \" + (char) lastNameIndex;\n19\t        course = courses[random.nextInt(3)];\n20\t        yearStarted = random.nextInt(2018, 2023);\n21\t    }\n22\t\n23\t    @Override\n24\t    public String toString() {\n25\t        return \"%-15s %-15s %d\".formatted(name, course, yearStarted);\n26\t    }\n27\t\n28\t    public int getYearStarted() {\n29\t        return yearStarted;\n30\t    }\n31\t}\n32\t ",
