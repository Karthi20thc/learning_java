      "id": "6c6a4bf9-40a4-470f-9a16-23f4575162f7",
      "cell_type": "code",
      "source": "// Folder resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\n// 5 printable files\n// (file list disabled)\n\n// resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.model.LPAStudent;\n4\timport dev.lpa.model.Student;\n5\timport dev.lpa.util.QueryItem;\n6\timport dev.lpa.util.QueryList;\n7\t\n8\timport java.util.ArrayList;\n9\timport java.util.List;\n10\t\n11\trecord Employee(String name) implements QueryItem {\n12\t\n13\t    @Override\n14\t    public boolean matchFieldValue(String fieldName, String value) {\n15\t        return false;\n16\t    }\n17\t}\n18\t\n19\tpublic class Main {\n20\t\n21\t    public static void main(String[] args) {\n22\t\n23\t        int studentCount = 10;\n24\t        List<Student> students = new ArrayList<>();\n25\t        for (int i = 0; i < studentCount; i++) {\n26\t            students.add(new Student());\n27\t        }\n28\t        students.add(new LPAStudent());\n29\t//        printList(students);\n30\t        printMoreLists(students);\n31\t\n32\t        List<LPAStudent> lpaStudents = new ArrayList<>();\n33\t        for (int i = 0; i < studentCount; i++) {\n34\t            lpaStudents.add(new LPAStudent());\n35\t        }\n36\t//        printList(lpaStudents);\n37\t        printMoreLists(lpaStudents);\n38\t\n39\t        testList(new ArrayList<String>(List.of(\"Able\", \"Barry\", \"Charlie\")));\n40\t        testList(new ArrayList<Integer>(List.of(1, 2, 3)));\n41\t\n42\t        var queryList = new QueryList<>(lpaStudents);\n43\t        var matches = queryList.getMatches(\n44\t                \"Course\", \"Python\");\n45\t        printMoreLists(matches);\n46\t\n47\t        var students2021 =\n48\t                QueryList.getMatches(students, \"YearStarted\", \"2021\");\n49\t        printMoreLists(students2021);\n50\t\n51\t//        QueryList<Employee> employeeList = new QueryList<>();\n52\t\n53\t    }\n54\t\n55\t    public static void printMoreLists(List<? extends Student> students) {\n56\t\n57\t        for (var student : students) {\n58\t            System.out.println(student);\n59\t        }\n60\t        System.out.println();\n61\t    }\n62\t\n63\t    public static void testList(List<?> list) {\n64\t\n65\t        for (var element : list) {\n66\t            if (element instanceof String s) {\n67\t                System.out.println(\"String: \" + s.toUpperCase());\n68\t            } else if (element instanceof Integer i) {\n69\t                System.out.println(\"Integer: \" + i.floatValue());\n70\t            }\n71\t        }\n72\t    }\n73\t\n74\t//    public static void testList(List<String> list) {\n75\t//\n76\t//        for (var element : list) {\n77\t//            System.out.println(\"String: \" + element.toUpperCase());\n78\t//        }\n79\t//    }\n80\t//\n81\t//    public static void testList(List<Integer> list) {\n82\t//\n83\t//        for (var element : list) {\n84\t//            System.out.println(\"Integer: \" + element.floatValue());\n85\t//        }\n86\t//    }\n87\t\n88\t//    public static <T extends Student> void printList(List<T> students) {\n89\t//\n90\t//        for (var student : students) {\n91\t//            System.out.println(student.getYearStarted() + \": \" + student);\n92\t//        }\n93\t//        System.out.println();\n94\t//    }\n95\t}\n96\t \n// resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\\dev\\lpa\\model\\LPAStudent.java\n1\tpackage dev.lpa.model;\n2\t\n3\tpublic class LPAStudent extends Student {\n4\t\n5\t    private double percentComplete;\n6\t\n7\t    public LPAStudent() {\n8\t        percentComplete = random.nextDouble(0, 100.001);\n9\t    }\n10\t\n11\t    @Override\n12\t    public String toString() {\n13\t        return \"%s %8.1f%%\".formatted(super.toString(), percentComplete);\n14\t    }\n15\t\n16\t    public double getPercentComplete() {\n17\t        return percentComplete;\n18\t    }\n19\t}\n20\t \n// resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\\dev\\lpa\\model\\Student.java\n1\tpackage dev.lpa.model;\n2\t\n3\timport dev.lpa.util.QueryItem;\n4\t\n5\timport java.util.Random;\n6\t\n7\tpublic class Student implements QueryItem {\n8\t\n9\t    private String name;\n10\t    private String course;\n11\t    private int yearStarted;\n12\t\n13\t    protected static Random random = new Random();\n14\t\n15\t    private static String[] firstNames = {\"Ann\", \"Bill\", \"Cathy\", \"John\", \"Tim\"};\n16\t    private static String[] courses = {\"C++\", \"Java\", \"Python\"};\n17\t\n18\t    public Student() {\n19\t        int lastNameIndex = random.nextInt(65, 91);\n20\t        name = firstNames[random.nextInt(5)] + \" \" + (char) lastNameIndex;\n21\t        course = courses[random.nextInt(3)];\n22\t        yearStarted = random.nextInt(2018, 2023);\n23\t    }\n24\t\n25\t    @Override\n26\t    public String toString() {\n27\t        return \"%-15s %-15s %d\".formatted(name, course, yearStarted);\n28\t    }\n29\t\n30\t    public int getYearStarted() {\n31\t        return yearStarted;\n32\t    }\n33\t\n34\t    @Override\n35\t    public boolean matchFieldValue(String fieldName, String value) {\n36\t\n37\t        String fName = fieldName.toUpperCase();\n38\t        return switch(fName) {\n39\t            case \"NAME\" -> name.equalsIgnoreCase(value);\n40\t            case \"COURSE\" -> course.equalsIgnoreCase(value);\n41\t            case \"YEARSTARTED\" -> yearStarted == (Integer.parseInt(value));\n42\t            default -> false;\n43\t        };\n44\t    }\n45\t}\n46\t \n// resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\\dev\\lpa\\util\\QueryItem.java\n1\tpackage dev.lpa.util;\n2\t\n3\tpublic interface QueryItem {\n4\t\n5\t    public boolean matchFieldValue(String fieldName, String value);\n6\t}\n7\t \n// resource\\Section 12\\9 Source-code-Generics-Static-methods-&-multiple-upper-bounds\\GenericsExtras\\src\\dev\\lpa\\util\\QueryList.java\n1\tpackage dev.lpa.util;\n2\t\n3\timport dev.lpa.model.Student;\n4\t\n5\timport java.util.ArrayList;\n6\timport java.util.List;\n7\t\n8\tpublic class QueryList <T extends Student & QueryItem> {\n9\t\n10\t    private List<T> items;\n11\t\n12\t    public QueryList(List<T> items) {\n13\t        this.items = items;\n14\t    }\n15\t\n16\t    public static <S extends QueryItem> List<S> getMatches(List<S> items,\n17\t                                                           String field, String value) {\n18\t\n19\t        List<S> matches = new ArrayList<>();\n20\t        for (var item : items) {\n21\t            if (item.matchFieldValue(field, value)) {\n22\t                matches.add(item);\n23\t            }\n24\t        }\n25\t        return matches;\n26\t    }\n27\t\n28\t    public List<T> getMatches(String field, String value) {\n29\t\n30\t        List<T> matches = new ArrayList<>();\n31\t        for (var item : items) {\n32\t            if (item.matchFieldValue(field, value)) {\n33\t                matches.add(item);\n34\t            }\n35\t        }\n36\t        return matches;\n37\t    }\n38\t}\n39\t ",
