      "id": "3d045145-40d7-42c6-b262-18f6e4fa46d9",
      "cell_type": "code",
      "source": "Folder resource\\Section 12\\6 Source-code-Generics-Revisiting-Comparable\\Comparing\\src\n1 printable files\n(file list disabled)\n\nresource\\Section 12\\6 Source-code-Generics-Revisiting-Comparable\\Comparing\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport java.util.Arrays;\n4\t\n5\tpublic class Main {\n6\t\n7\t    public static void main(String[] args) {\n8\t\n9\t        Integer five = 5;\n10\t        Integer[] others = {0, 5, 10, -50, 50};\n11\t\n12\t        for (Integer i : others) {\n13\t            int val = five.compareTo(i);\n14\t            System.out.printf(\"%d %s %d: compareTo=%d%n\", five,\n15\t                    (val == 0 ? \"==\" : (val < 0) ? \"<\" : \">\"), i, val);\n16\t        }\n17\t\n18\t        String banana = \"banana\";\n19\t        String[] fruit = {\"apple\", \"banana\", \"pear\", \"BANANA\"};\n20\t\n21\t        for (String s : fruit) {\n22\t            int val = banana.compareTo(s);\n23\t            System.out.printf(\"%s %s %s: compareTo=%d%n\", banana,\n24\t                    (val == 0 ? \"==\" : (val < 0) ? \"<\" : \">\"), s, val);\n25\t        }\n26\t\n27\t        Arrays.sort(fruit);\n28\t        System.out.println(Arrays.toString(fruit));\n29\t\n30\t        System.out.println(\"A:\"+(int)'A' + \" \" + \"a:\"+(int)'a');\n31\t        System.out.println(\"B:\"+(int)'B' + \" \" + \"b:\"+(int)'b');\n32\t        System.out.println(\"P:\"+(int)'P' + \" \" + \"p:\"+(int)'p');\n33\t\n34\t        Student tim = new Student (\"Tim\");\n35\t        Student [] students = {new Student(\"Zach\"), new Student(\"Tim\"),\n36\t                new Student(\"Ann\")};\n37\t\n38\t        Arrays.sort(students);\n39\t        System.out.println(Arrays.toString(students));\n40\t\n41\t        System.out.println(\"result = \" + tim.compareTo(\"Mary\"));\n42\t\n43\t    }\n44\t}\n45\t\n46\tclass Student implements Comparable {\n47\t\n48\t    private String name;\n49\t\n50\t    public Student(String name) {\n51\t        this.name = name;\n52\t    }\n53\t\n54\t    @Override\n55\t    public String toString() {\n56\t        return name;\n57\t    }\n58\t\n59\t    @Override\n60\t    public int compareTo(Object o) {\n61\t        Student other = (Student) o;\n62\t        return name.compareTo(other.name);\n63\t    }\n64\t}\n65\t\n66\t ",
