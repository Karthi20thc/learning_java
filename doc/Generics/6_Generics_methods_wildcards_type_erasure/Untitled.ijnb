      "source": "// Folder resource\\Section 12\\8 Source-code-Generics-Generics-methods,-wildcards,-and-type-erasure\\GenericsExtras\\src\n// 3 printable files\n// (file list disabled)\n\n// resource\\Section 12\\8 Source-code-Generics-Generics-methods,-wildcards,-and-type-erasure\\GenericsExtras\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.model.LPAStudent;\n4\timport dev.lpa.model.Student;\n5\t\n6\timport java.util.ArrayList;\n7\timport java.util.List;\n8\t\n9\tpublic class Main {\n10\t\n11\t    public static void main(String[] args) {\n12\t\n13\t        int studentCount = 10;\n14\t        List<Student> students = new ArrayList<>();\n15\t        for (int i = 0; i < studentCount; i++) {\n16\t            students.add(new Student());\n17\t        }\n18\t        students.add(new LPAStudent());\n19\t//        printList(students);\n20\t        printMoreLists(students);\n21\t\n22\t        List<LPAStudent> lpaStudents = new ArrayList<>();\n23\t        for (int i = 0; i < studentCount; i++) {\n24\t            lpaStudents.add(new LPAStudent());\n25\t        }\n26\t//        printList(lpaStudents);\n27\t        printMoreLists(lpaStudents);\n28\t\n29\t        testList(new ArrayList<String>(List.of(\"Able\", \"Barry\", \"Charlie\")));\n30\t        testList(new ArrayList<Integer>(List.of(1, 2, 3)));\n31\t\n32\t    }\n33\t\n34\t    public static void printMoreLists(List<? extends Student> students) {\n35\t\n36\t        for (var student : students) {\n37\t            System.out.println(student);\n38\t        }\n39\t        System.out.println();\n40\t    }\n41\t\n42\t    public static void testList(List<?> list) {\n43\t\n44\t        for (var element : list) {\n45\t            if (element instanceof String s) {\n46\t                System.out.println(\"String: \" + s.toUpperCase());\n47\t            } else if (element instanceof Integer i) {\n48\t                System.out.println(\"Integer: \" + i.floatValue());\n49\t            }\n50\t        }\n51\t    }\n52\t\n53\t//    public static void testList(List<String> list) {\n54\t//\n55\t//        for (var element : list) {\n56\t//            System.out.println(\"String: \" + element.toUpperCase());\n57\t//        }\n58\t//    }\n59\t//\n60\t//    public static void testList(List<Integer> list) {\n61\t//\n62\t//        for (var element : list) {\n63\t//            System.out.println(\"Integer: \" + element.floatValue());\n64\t//        }\n65\t//    }\n66\t\n67\t//    public static <T extends Student> void printList(List<T> students) {\n68\t//\n69\t//        for (var student : students) {\n70\t//            System.out.println(student.getYearStarted() + \": \" + student);\n71\t//        }\n72\t//        System.out.println();\n73\t//    }\n74\t}\n75\t \n// resource\\Section 12\\8 Source-code-Generics-Generics-methods,-wildcards,-and-type-erasure\\GenericsExtras\\src\\dev\\lpa\\model\\LPAStudent.java\n1\tpackage dev.lpa.model;\n2\t\n3\tpublic class LPAStudent extends Student {\n4\t\n5\t    private double percentComplete;\n6\t\n7\t    public LPAStudent() {\n8\t        percentComplete = random.nextDouble(0, 100.001);\n9\t    }\n10\t\n11\t    @Override\n12\t    public String toString() {\n13\t        return \"%s %8.1f%%\".formatted(super.toString(), percentComplete);\n14\t    }\n15\t\n16\t    public double getPercentComplete() {\n17\t        return percentComplete;\n18\t    }\n19\t}\n20\t \n// resource\\Section 12\\8 Source-code-Generics-Generics-methods,-wildcards,-and-type-erasure\\GenericsExtras\\src\\dev\\lpa\\model\\Student.java\n1\tpackage dev.lpa.model;\n2\t\n3\timport java.util.Random;\n4\t\n5\tpublic class Student {\n6\t\n7\t    private String name;\n8\t    private String course;\n9\t    private int yearStarted;\n10\t\n11\t    protected static Random random = new Random();\n12\t\n13\t    private static String[] firstNames = {\"Ann\", \"Bill\", \"Cathy\", \"John\", \"Tim\"};\n14\t    private static String[] courses = {\"C++\", \"Java\", \"Python\"};\n15\t\n16\t    public Student() {\n17\t        int lastNameIndex = random.nextInt(65, 91);\n18\t        name = firstNames[random.nextInt(5)] + \" \" + (char) lastNameIndex;\n19\t        course = courses[random.nextInt(3)];\n20\t        yearStarted = random.nextInt(2018, 2023);\n21\t    }\n22\t\n23\t    @Override\n24\t    public String toString() {\n25\t        return \"%-15s %-15s %d\".formatted(name, course, yearStarted);\n26\t    }\n27\t\n28\t    public int getYearStarted() {\n29\t        return yearStarted;\n30\t    }\n31\t}\n32\t ",
