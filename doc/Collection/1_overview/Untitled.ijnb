      "id": "486c6df3-4a85-4967-9cfd-00436088f6b2",
      "cell_type": "code",
      "source": "// resource/Section 15/1 Source-code-Java-Collections-Collections-Understanding-the-Big-Picture/CollectionsOverview/src/dev/lpa/Main.java\n\n1\tpackage dev.lpa;\n2\t \n3\timport java.util.Arrays;\n4\timport java.util.Collection;\n5\timport java.util.HashSet;\n6\t \n7\tpublic class Main {\n8\t \n9\t    public static void main(String[] args) {\n10\t \n11\t        Collection<String> list = new HashSet<>();\n12\t \n13\t        String[] names = {\"Anna\", \"Bob\", \"Carol\", \"David\", \"Edna\"};\n14\t        list.addAll(Arrays.asList(names));\n15\t        System.out.println(list);\n16\t \n17\t        list.add(\"Fred\");\n18\t        list.addAll(Arrays.asList(\"George\", \"Gary\", \"Grace\"));\n19\t        System.out.println(list);\n20\t        System.out.println(\"Gary is in the list? \" + list.contains(\"Gary\"));\n21\t \n22\t        list.removeIf(s -> s.charAt(0) == 'G');\n23\t        System.out.println(list);\n24\t        System.out.println(\"Gary is in the list? \" + list.contains(\"Gary\"));\n25\t//        list.sort();\n26\t    }\n27\t}\n28\t ",
      "metadata": {
        "language": "java"
      },
