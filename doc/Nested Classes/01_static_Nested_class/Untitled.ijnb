      "id": "3e3d48a9-5030-4e11-8e4b-503b020b8911",
      "cell_type": "code",
      "source": "// Folder resource\\Section 13\\1 Nested-Classes-and-Types-Static-Nested-Classes\\NestedClasses\\src\n// 3 printable files\n// (file list disabled)\n\n// resource\\Section 13\\1 Nested-Classes-and-Types-Static-Nested-Classes\\NestedClasses\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.domain.Employee;\n4\t\n5\timport java.util.ArrayList;\n6\timport java.util.List;\n7\t\n8\tpublic class Main {\n9\t\n10\t    public static void main(String[] args) {\n11\t\n12\t        List<Employee> employees = new ArrayList<>(List.of(\n13\t                new Employee(10001, \"Ralph\", 2015),\n14\t                new Employee(10005, \"Carole\", 2021),\n15\t                new Employee(10022, \"Jane\", 2013),\n16\t                new Employee(13151, \"Laura\", 2020),\n17\t                new Employee(10050, \"Jim\", 2018) ));\n18\t\n19\t//        var comparator = new EmployeeComparator<>();\n20\t//        employees.sort(comparator);\n21\t\n22\t        employees.sort(new Employee.EmployeeComparator<>(\"yearStarted\")\n23\t                .reversed());\n24\t\n25\t        for (Employee e : employees) {\n26\t            System.out.println(e);\n27\t        }\n28\t\n29\t    }\n30\t}\n31\t \n// resource\\Section 13\\1 Nested-Classes-and-Types-Static-Nested-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\Employee.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class Employee {\n6\t\n7\t    public static class EmployeeComparator <T extends Employee>\n8\t            implements Comparator<Employee> {\n9\t\n10\t        private String sortType;\n11\t\n12\t        public EmployeeComparator() {\n13\t            this(\"name\");\n14\t        }\n15\t\n16\t        public EmployeeComparator(String sortType) {\n17\t            this.sortType = sortType;\n18\t        }\n19\t\n20\t        @Override\n21\t        public int compare(Employee o1, Employee o2) {\n22\t\n23\t            if (sortType.equalsIgnoreCase(\"yearStarted\")) {\n24\t                return o1.yearStarted - o2.yearStarted;\n25\t            }\n26\t\n27\t            return o1.name.compareTo(o2.name);\n28\t        }\n29\t    }\n30\t\n31\t    private int employeeId;\n32\t    private String name;\n33\t    private int yearStarted;\n34\t\n35\t    public Employee() {\n36\t    }\n37\t\n38\t    public Employee(int employeeId, String name, int yearStarted) {\n39\t        this.employeeId = employeeId;\n40\t        this.name = name;\n41\t        this.yearStarted = yearStarted;\n42\t    }\n43\t\n44\t    public String getName() {\n45\t        return name;\n46\t    }\n47\t\n48\t    @Override\n49\t    public String toString() {\n50\t        return \"%d %-8s %d\".formatted(employeeId, name, yearStarted);\n51\t    }\n52\t}\n53\t \n// resource\\Section 13\\1 Nested-Classes-and-Types-Static-Nested-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\EmployeeComparator.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class EmployeeComparator <T extends Employee> implements Comparator<Employee> {\n6\t\n7\t    @Override\n8\t    public int compare(Employee o1, Employee o2) {\n9\t        return o1.getName().compareTo(o2.getName());\n10\t    }\n11\t}\n12\t ",
