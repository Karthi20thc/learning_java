      "source": "Folder resource\\Section 13\\2 Nested-Classes-and-Types-Inner-Classes\\NestedClasses\\src\n4 printable files\n(file list disabled)\n\nresource\\Section 13\\2 Nested-Classes-and-Types-Inner-Classes\\NestedClasses\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.domain.Employee;\n4\timport dev.lpa.domain.StoreEmployee;\n5\t\n6\timport java.util.ArrayList;\n7\timport java.util.List;\n8\t\n9\tpublic class Main {\n10\t\n11\t    public static void main(String[] args) {\n12\t\n13\t        List<Employee> employees = new ArrayList<>(List.of(\n14\t                new Employee(10001, \"Ralph\", 2015),\n15\t                new Employee(10005, \"Carole\", 2021),\n16\t                new Employee(10022, \"Jane\", 2013),\n17\t                new Employee(13151, \"Laura\", 2020),\n18\t                new Employee(10050, \"Jim\", 2018) ));\n19\t\n20\t//        var comparator = new EmployeeComparator<>();\n21\t//        employees.sort(comparator);\n22\t\n23\t        employees.sort(new Employee.EmployeeComparator<>(\"yearStarted\")\n24\t                .reversed());\n25\t\n26\t        for (Employee e : employees) {\n27\t            System.out.println(e);\n28\t        }\n29\t\n30\t        System.out.println(\"Store Members\");\n31\t\n32\t        List<StoreEmployee> storeEmployees = new ArrayList<>(List.of(\n33\t                new StoreEmployee(10015, \"Meg\", 2019,\n34\t                        \"Target\"),\n35\t            new StoreEmployee(10515, \"Joe\", 2021,\n36\t                    \"Walmart\"),\n37\t            new StoreEmployee(10105, \"Tom\", 2020,\n38\t                    \"Macys\"),\n39\t            new StoreEmployee(10215, \"Marty\", 2018,\n40\t                    \"Walmart\"),\n41\t            new StoreEmployee(10322, \"Bud\", 2016,\n42\t                    \"Target\")));\n43\t\n44\t        var comparator = new StoreEmployee().new StoreComparator<>();\n45\t        storeEmployees.sort(comparator);\n46\t\n47\t        for (StoreEmployee e : storeEmployees) {\n48\t            System.out.println(e);\n49\t        }\n50\t\n51\t    }\n52\t}\n53\t \nresource\\Section 13\\2 Nested-Classes-and-Types-Inner-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\Employee.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class Employee {\n6\t\n7\t    public static class EmployeeComparator <T extends Employee>\n8\t            implements Comparator<Employee> {\n9\t\n10\t        private String sortType;\n11\t\n12\t        public EmployeeComparator() {\n13\t            this(\"name\");\n14\t        }\n15\t\n16\t        public EmployeeComparator(String sortType) {\n17\t            this.sortType = sortType;\n18\t        }\n19\t\n20\t        @Override\n21\t        public int compare(Employee o1, Employee o2) {\n22\t\n23\t            if (sortType.equalsIgnoreCase(\"yearStarted\")) {\n24\t                return o1.yearStarted - o2.yearStarted;\n25\t            }\n26\t\n27\t            return o1.name.compareTo(o2.name);\n28\t        }\n29\t    }\n30\t\n31\t    private int employeeId;\n32\t    private String name;\n33\t    private int yearStarted;\n34\t\n35\t    public Employee() {\n36\t    }\n37\t\n38\t    public Employee(int employeeId, String name, int yearStarted) {\n39\t        this.employeeId = employeeId;\n40\t        this.name = name;\n41\t        this.yearStarted = yearStarted;\n42\t    }\n43\t\n44\t    public String getName() {\n45\t        return name;\n46\t    }\n47\t\n48\t    @Override\n49\t    public String toString() {\n50\t        return \"%d %-8s %d\".formatted(employeeId, name, yearStarted);\n51\t    }\n52\t}\n53\t \nresource\\Section 13\\2 Nested-Classes-and-Types-Inner-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\EmployeeComparator.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class EmployeeComparator <T extends Employee> implements Comparator<Employee> {\n6\t\n7\t    @Override\n8\t    public int compare(Employee o1, Employee o2) {\n9\t        return o1.getName().compareTo(o2.getName());\n10\t    }\n11\t}\n12\t \nresource\\Section 13\\2 Nested-Classes-and-Types-Inner-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\StoreEmployee.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class StoreEmployee extends Employee {\n6\t\n7\t    private String store;\n8\t\n9\t    public StoreEmployee() {\n10\t    }\n11\t\n12\t    public StoreEmployee(int employeeId, String name, int yearStarted, String store) {\n13\t        super(employeeId, name, yearStarted);\n14\t        this.store = store;\n15\t    }\n16\t\n17\t    @Override\n18\t    public String toString() {\n19\t        return \"%-8s%s\".formatted(store, super.toString());\n20\t    }\n21\t\n22\t    public class StoreComparator<T extends StoreEmployee>\n23\t        implements Comparator<StoreEmployee> {\n24\t\n25\t        @Override\n26\t        public int compare(StoreEmployee o1, StoreEmployee o2) {\n27\t\n28\t            int result = o1.store.compareTo(o2.store);\n29\t            if (result == 0) {\n30\t                return new Employee.EmployeeComparator<>(\n31\t                        \"yearStarted\").compare(o1, o2);\n32\t            }\n33\t\n34\t            return result;\n35\t        }\n36\t    }\n37\t\n38\t}\n39\t ",
