  "cells": [
    {
      "id": "32b941bf-c7c9-49e9-ad18-da50072a4a05",
      "cell_type": "code",
      "source": "Folder resource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\n7 printable files\n(file list disabled)\n\nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\Main.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.domain.Employee;\n4\timport dev.lpa.domain.StoreEmployee;\n5\t\n6\timport java.util.ArrayList;\n7\timport java.util.List;\n8\t\n9\tpublic class Main {\n10\t\n11\t    public static void main(String[] args) {\n12\t\n13\t        List<Employee> employees = new ArrayList<>(List.of(\n14\t                new Employee(10001, \"Ralph\", 2015),\n15\t                new Employee(10005, \"Carole\", 2021),\n16\t                new Employee(10022, \"Jane\", 2013),\n17\t                new Employee(13151, \"Laura\", 2020),\n18\t                new Employee(10050, \"Jim\", 2018) ));\n19\t\n20\t//        var comparator = new EmployeeComparator<>();\n21\t//        employees.sort(comparator);\n22\t\n23\t        employees.sort(new Employee.EmployeeComparator<>(\"yearStarted\")\n24\t                .reversed());\n25\t\n26\t        for (Employee e : employees) {\n27\t            System.out.println(e);\n28\t        }\n29\t\n30\t        System.out.println(\"Store Members\");\n31\t\n32\t        List<StoreEmployee> storeEmployees = new ArrayList<>(List.of(\n33\t                new StoreEmployee(10015, \"Meg\", 2019,\n34\t                        \"Target\"),\n35\t            new StoreEmployee(10515, \"Joe\", 2021,\n36\t                    \"Walmart\"),\n37\t            new StoreEmployee(10105, \"Tom\", 2020,\n38\t                    \"Macys\"),\n39\t            new StoreEmployee(10215, \"Marty\", 2018,\n40\t                    \"Walmart\"),\n41\t            new StoreEmployee(10322, \"Bud\", 2016,\n42\t                    \"Target\")));\n43\t\n44\t        var comparator = new StoreEmployee().new StoreComparator<>();\n45\t        storeEmployees.sort(comparator);\n46\t\n47\t        for (StoreEmployee e : storeEmployees) {\n48\t            System.out.println(e);\n49\t        }\n50\t\n51\t        System.out.println(\"With Pig Latin Names\");\n52\t        addPigLatinName(storeEmployees);\n53\t    }\n54\t\n55\t    public static void addPigLatinName(List<? extends StoreEmployee> list) {\n56\t\n57\t        String lastName = \"Piggy\";\n58\t\n59\t        class DecoratedEmployee extends StoreEmployee\n60\t                implements Comparable<DecoratedEmployee> {\n61\t\n62\t            private String pigLatinName;\n63\t            private Employee originalInstance;\n64\t\n65\t            public DecoratedEmployee(String pigLatinName, Employee originalInstance) {\n66\t                this.pigLatinName = pigLatinName + \" \" + lastName;\n67\t                this.originalInstance = originalInstance;\n68\t            }\n69\t\n70\t            @Override\n71\t            public String toString() {\n72\t                return originalInstance.toString() + \" \" + pigLatinName;\n73\t            }\n74\t\n75\t            @Override\n76\t            public int compareTo(DecoratedEmployee o) {\n77\t                return pigLatinName.compareTo(o.pigLatinName);\n78\t            }\n79\t        }\n80\t\n81\t        List<DecoratedEmployee> newList = new ArrayList<>(list.size());\n82\t\n83\t        for (var employee : list) {\n84\t            String name = employee.getName();\n85\t            String pigLatin = name.substring(1) + name.charAt(0) + \"ay\";\n86\t            newList.add(new DecoratedEmployee(pigLatin, employee));\n87\t        }\n88\t\n89\t        newList.sort(null);\n90\t        for (var dEmployee : newList) {\n91\t            System.out.println(dEmployee.originalInstance.getName() + \" \"\n92\t                    + dEmployee.pigLatinName);\n93\t        }\n94\t    }\n95\t\n96\t}\n97\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\RunMethods.java\n1\tpackage dev.lpa;\n2\t\n3\timport dev.lpa.domain.Employee;\n4\timport dev.lpa.domain.EmployeeComparator;\n5\timport dev.lpa.domain.StoreEmployee;\n6\t\n7\timport java.util.ArrayList;\n8\timport java.util.Comparator;\n9\timport java.util.List;\n10\t\n11\tpublic class RunMethods {\n12\t\n13\t    public static void main(String[] args) {\n14\t\n15\t        List<StoreEmployee> storeEmployees = new ArrayList<>(List.of(\n16\t                new StoreEmployee(10015, \"Meg\", 2019,\n17\t                        \"Target\"),\n18\t                new StoreEmployee(10515, \"Joe\", 2021,\n19\t                        \"Walmart\"),\n20\t                new StoreEmployee(10105, \"Tom\", 2020,\n21\t                        \"Macys\"),\n22\t                new StoreEmployee(10215, \"Marty\", 2018,\n23\t                        \"Walmart\"),\n24\t                new StoreEmployee(10322, \"Bud\", 2016,\n25\t                        \"Target\")));\n26\t\n27\t        var c0 = new EmployeeComparator<StoreEmployee>();\n28\t        var c1 = new Employee.EmployeeComparator<StoreEmployee>();\n29\t        var c2 = new StoreEmployee().new StoreComparator<StoreEmployee>();\n30\t\n31\t        // Using local class\n32\t        class NameSort<T> implements Comparator<StoreEmployee> {\n33\t\n34\t            @Override\n35\t            public int compare(StoreEmployee o1, StoreEmployee o2) {\n36\t                return o1.getName().compareTo(o2.getName());\n37\t            }\n38\t        }\n39\t\n40\t        var c3 = new NameSort<StoreEmployee>();\n41\t\n42\t        // Using anonymous class\n43\t        var c4 = new Comparator<StoreEmployee>() {\n44\t            @Override\n45\t            public int compare(StoreEmployee o1, StoreEmployee o2) {\n46\t                return o1.getName().compareTo(o2.getName());\n47\t            }\n48\t        };\n49\t\n50\t        sortIt(storeEmployees, c0);\n51\t        sortIt(storeEmployees, c1);\n52\t        sortIt(storeEmployees, c2);\n53\t        sortIt(storeEmployees, c3);\n54\t        sortIt(storeEmployees, c4);\n55\t        sortIt(storeEmployees, (o1, o2) -> o1.getName().compareTo(o2.getName()));\n56\t    }\n57\t\n58\t    public static <T> void sortIt(List<T> list,\n59\t                                  Comparator<? super T> comparator) {\n60\t\n61\t        System.out.println(\"Sorting with Comparator: \" + comparator.toString());\n62\t        list.sort(comparator);\n63\t        for (var employee : list) {\n64\t            System.out.println(employee);\n65\t        }\n66\t    }\n67\t\n68\t}\n69\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\burger\\Meal.java\n1\tpackage dev.lpa.burger;\n2\t\n3\timport java.util.ArrayList;\n4\timport java.util.List;\n5\t\n6\tpublic class Meal {\n7\t\n8\t    private double price = 5.0;\n9\t    private Burger burger;\n10\t    private Item drink;\n11\t    private Item side;\n12\t\n13\t    private double conversionRate;\n14\t\n15\t    public Meal() {\n16\t        this(1);\n17\t    }\n18\t\n19\t    public Meal(double conversionRate) {\n20\t        this.conversionRate = conversionRate;\n21\t        burger = new Burger(\"regular\");\n22\t        drink = new Item(\"coke\", \"drink\", 1.5);\n23\t        System.out.println(drink.name);\n24\t        side = new Item(\"fries\", \"side\", 2.0);\n25\t    }\n26\t\n27\t    public double getTotal() {\n28\t\n29\t        double total = burger.getPrice() + drink.price + side.price;\n30\t        return Item.getPrice(total, conversionRate);\n31\t    }\n32\t\n33\t    @Override\n34\t    public String toString() {\n35\t        return \"%s%n%s%n%s%n%26s$%.2f\".formatted(burger, drink, side,\n36\t                \"Total Due: \", getTotal());\n37\t    }\n38\t\n39\t    public void addToppings(String... selectedToppings) {\n40\t        burger.addToppings(selectedToppings);\n41\t    }\n42\t\n43\t    private class Item {\n44\t\n45\t        private String name;\n46\t        private String type;\n47\t        private double price;\n48\t\n49\t        public Item(String name, String type) {\n50\t            this(name, type, type.equals(\"burger\") ? Meal.this.price : 0);\n51\t        }\n52\t\n53\t        public Item(String name, String type, double price) {\n54\t            this.name = name;\n55\t            this.type = type;\n56\t            this.price = price;\n57\t        }\n58\t\n59\t        @Override\n60\t        public String toString() {\n61\t            return \"%10s%15s $%.2f\".formatted(type, name,\n62\t                    getPrice(price, conversionRate));\n63\t        }\n64\t\n65\t        private static double getPrice(double price, double rate) {\n66\t            return price * rate;\n67\t        }\n68\t    }\n69\t\n70\t    private class Burger extends Item {\n71\t\n72\t        private enum Extra {AVOCADO, BACON, CHEESE, KETCHUP, MAYO, MUSTARD, PICKLES;\n73\t\n74\t            private double getPrice() {\n75\t                return switch (this) {\n76\t                    case AVOCADO -> 1.0;\n77\t                    case BACON, CHEESE -> 1.5;\n78\t                    default -> 0;\n79\t                };\n80\t            }\n81\t\n82\t        }\n83\t\n84\t        private List<Item> toppings = new ArrayList<>();\n85\t        Burger(String name) {\n86\t            super(name, \"burger\", 5.0);\n87\t        }\n88\t\n89\t        public double getPrice() {\n90\t\n91\t            double total = super.price;\n92\t            for (Item topping : toppings) {\n93\t                total += topping.price;\n94\t            }\n95\t            return total;\n96\t        }\n97\t\n98\t        private void addToppings(String... selectedToppings) {\n99\t\n100\t            for (String selectedTopping : selectedToppings) {\n101\t                try {\n102\t                    Extra topping = Extra.valueOf(selectedTopping.toUpperCase());\n103\t                    toppings.add(new Item(topping.name(), \"TOPPING\",\n104\t                            topping.getPrice()));\n105\t                } catch (IllegalArgumentExcep­tion ie) {\n106\t                    System.out.println(\"No topping found for \" + selectedTopping);\n107\t                }\n108\t            }\n109\t        }\n110\t\n111\t        @Override\n112\t        public String toString() {\n113\t\n114\t            StringBuilder itemized = new StringBuilder(super.toString());\n115\t            for (Item topping : toppings) {\n116\t                itemized.append(\"\\n\");\n117\t                itemized.append(topping);\n118\t            }\n119\t\n120\t            return itemized.toString();\n121\t        }\n122\t\n123\t    }\n124\t\n125\t}\n126\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\burger\\Store.java\n1\tpackage dev.lpa.burger;\n2\t\n3\tpublic class Store {\n4\t\n5\t    public static void main(String[] args) {\n6\t\n7\t        Meal regularMeal = new Meal();\n8\t        regularMeal.addToppings(\"Ketchup\", \"Mayo\", \"Bacon\", \"Cheddar\");\n9\t        System.out.println(regularMeal);\n10\t\n11\t        Meal USRegularMeal = new Meal(0.68);\n12\t        System.out.println(USRegularMeal);\n13\t\n14\t    }\n15\t}\n16\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\Employee.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class Employee {\n6\t\n7\t    public static class EmployeeComparator <T extends Employee>\n8\t            implements Comparator<Employee> {\n9\t\n10\t        private String sortType;\n11\t\n12\t        public EmployeeComparator() {\n13\t            this(\"name\");\n14\t        }\n15\t\n16\t        public EmployeeComparator(String sortType) {\n17\t            this.sortType = sortType;\n18\t        }\n19\t\n20\t        @Override\n21\t        public int compare(Employee o1, Employee o2) {\n22\t\n23\t            if (sortType.equalsIgnoreCase(\"yearStarted\")) {\n24\t                return o1.yearStarted - o2.yearStarted;\n25\t            }\n26\t\n27\t            return o1.name.compareTo(o2.name);\n28\t        }\n29\t    }\n30\t\n31\t    private int employeeId;\n32\t    private String name;\n33\t    private int yearStarted;\n34\t\n35\t    public Employee() {\n36\t    }\n37\t\n38\t    public Employee(int employeeId, String name, int yearStarted) {\n39\t        this.employeeId = employeeId;\n40\t        this.name = name;\n41\t        this.yearStarted = yearStarted;\n42\t    }\n43\t\n44\t    public String getName() {\n45\t        return name;\n46\t    }\n47\t\n48\t    @Override\n49\t    public String toString() {\n50\t        return \"%d %-8s %d\".formatted(employeeId, name, yearStarted);\n51\t    }\n52\t}\n53\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\EmployeeComparator.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class EmployeeComparator <T extends Employee> implements Comparator<Employee> {\n6\t\n7\t    @Override\n8\t    public int compare(Employee o1, Employee o2) {\n9\t        return o1.getName().compareTo(o2.getName());\n10\t    }\n11\t}\n12\t \nresource\\Section 13\\6 Nested-Classes-and-Types-Anonymous-Classes\\NestedClasses\\src\\dev\\lpa\\domain\\StoreEmployee.java\n1\tpackage dev.lpa.domain;\n2\t\n3\timport java.util.Comparator;\n4\t\n5\tpublic class StoreEmployee extends Employee {\n6\t\n7\t    private String store;\n8\t\n9\t    public StoreEmployee() {\n10\t    }\n11\t\n12\t    public StoreEmployee(int employeeId, String name, int yearStarted, String store) {\n13\t        super(employeeId, name, yearStarted);\n14\t        this.store = store;\n15\t    }\n16\t\n17\t    @Override\n18\t    public String toString() {\n19\t        return \"%-8s%s\".formatted(store, super.toString());\n20\t    }\n21\t\n22\t    public class StoreComparator<T extends StoreEmployee>\n23\t        implements Comparator<StoreEmployee> {\n24\t\n25\t        @Override\n26\t        public int compare(StoreEmployee o1, StoreEmployee o2) {\n27\t\n28\t            int result = o1.store.compareTo(o2.store);\n29\t            if (result == 0) {\n30\t                return new Employee.EmployeeComparator<>(\n31\t                        \"yearStarted\").compare(o1, o2);\n32\t            }\n33\t\n34\t            return result;\n35\t        }\n36\t    }\n37\t\n38\t}\n39\t ",
