      "cell_type": "code",
      "source": "// wrong\nimport java.util.Arrays;\nimport java.util.ArrayList;\nimport java.util.List;\n\nclass Main {\n    public static void main(String[] args) {\n\n        ArrayList<String> mylist = new ArrayList<>();\n        mylist.add(\"first\");\n        mylist.add(\"second\");\n        mylist.add(\"third\");\n       \n        mylist.forEach(x -> System.out::println);\n    }\n}",
